{
  "name": "converge-defaults",
  "displayName": "Converlt Defaults",
  "description": "Theme and default settings for the Converlt IDE.",
  "version": "0.1.0",
  "publisher": "converge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "Converlt Dark",
        "label": "Converlt Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/converge-dark.json"
      },
      {
        "id": "Converlt Midnight",
        "label": "Converlt Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/converge-midnight.json"
      },
      {
        "id": "Converlt Ember",
        "label": "Converlt Ember",
        "uiTheme": "vs-dark",
        "path": "./themes/converge-ember.json"
      },
      {
        "id": "Converlt Forest",
        "label": "Converlt Forest",
        "uiTheme": "vs-dark",
        "path": "./themes/converge-forest.json"
      },
      {
        "id": "Converlt Light",
        "label": "Converlt Light",
        "uiTheme": "vs",
        "path": "./themes/converge-light.json"
      },
      {
        "id": "Converlt Paper",
        "label": "Converlt Paper",
        "uiTheme": "vs",
        "path": "./themes/converge-paper.json"
      },
      {
        "id": "Converlt High Contrast",
        "label": "Converlt High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/converge-high-contrast.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Converlt Dark",
      "workbench.preferredDarkColorTheme": "Converlt Dark",
      "workbench.preferredLightColorTheme": "Converlt Light",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "window.commandCenter": true,
      "window.title": "${rootName}${separator}Converlt",
      "workbench.activityBar.location": "top",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.editor.empty.hint": "hidden",
      "window.density.editorTabHeight": "compact",
      "chat.agentsControl.enabled": "hidden",
      "chat.titleBar.signIn.enabled": false,
      "chat.titleBar.openInAgentsWindow.enabled": false,
      "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, 'Courier New', monospace",
      "editor.fontSize": 13.5,
      "editor.lineHeight": 1.6,
      "editor.renderLineHighlight": "all",
      "editor.cursorBlinking": "smooth",
      "editor.smoothScrolling": true,
      "editor.minimap.renderCharacters": false,
      "files.exclude": {
        "**/.converge": true
      },
      "telemetry.telemetryLevel": "off",
      "update.mode": "none",
      "window.menuBarVisibility": "compact"
    }
  }
}
