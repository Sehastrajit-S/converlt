{
  "name": "converge",
  "private": true,
  "version": "0.1.0",
  "description": "Converlt — the ML-native IDE that connects your code, GPUs, and experiments.",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "fetch": "bash ide/fetch.sh",
    "build": "bash ide/build.sh",
    "build:dev": "bash ide/build.sh --dev",
    "build:extension": "pnpm --filter ./ide/extensions/converge build",
    "watch:extension": "pnpm --filter ./ide/extensions/converge watch",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:agent": "python -m unittest discover -s services/remote-agent/tests -v"
  }
}
