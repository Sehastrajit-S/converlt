{
  "name": "@converge/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Converlt Gateway: credits ledger, on-demand GPUs (RunPod) and models (OpenRouter) behind one Converlt token.",
  "scripts": {
