    "build:vercel": "node vercel/build.mjs"
  },
  "devDependencies": {
    "@converge/core": "workspace:*",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^22.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  }
}
